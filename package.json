{
  "name": "tap-along",
  "productName": "tap-along",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "longtengsong",
    "email": "tengsonglong.gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/main/db/**/*.ts\" --test-coverage-include=\"src/main/ipc/**/*.ts\" --test-coverage-include=\"src/main/prompts/**/*.ts\" --test-coverage-include=\"src/main/services/**/*.ts\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-reporter=./tests/reporters/chinese-reporter.mjs \"tests/**/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=./tests/reporters/chinese-reporter.mjs \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": "pnpm@11.21.0"
  },
  "peerDependencies": {
    "electron-winstaller": "^5.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.2.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  }
}
